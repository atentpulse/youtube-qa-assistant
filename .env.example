# ==============================================================================
# YtGenius Environment Configuration Template
# ==============================================================================

# Application Environment (development, testing, staging, production)
# In production, OpenAPI docs (/docs, /redoc, /openapi.json) are automatically disabled.
ENVIRONMENT=development
PORT=8000
HTTP_PORT=80
WORKERS=4

# ==============================
# Database (PostgreSQL)
# ==============================
# In production (ENVIRONMENT=production), localhost addresses and default credentials will cause
# the backend to reject startup. Use your managed PostgreSQL host or container service name.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/youtube_qa_db

# Connection Pool Settings
# Connection budget formula: WORKERS * (DB_POOL_SIZE + DB_MAX_OVERFLOW) <= usable application connections.
# Standard PostgreSQL defaults to max_connections=100 with superuser_reserved_connections=3 (97 usable application slots).
# Single deployment budget: 4 * (5 + 5) = 40 peak backend connections, leaving 57 slots during steady-state single deployment.
# Rolling deployment budget (two simultaneous deployments): 2 * 40 = 80 peak connections, leaving 97 - 80 = 17 slots
# for additional database consumers (Alembic migrations, health probes, DBA triage).
# Note: 57 slots are not permanently available (headroom drops to 17 during rollouts), and actual availability
# depends on the PostgreSQL server configuration.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# ==============================
# JWT & Session Authentication
# ==============================
# SECRET_KEY must be a cryptographically secure random string (at least 32 characters)
SECRET_KEY=replace-with-a-long-random-secret-key-at-least-32-chars

# Dedicated secret key for encrypting OAuth/session cookies (falls back to SECRET_KEY if omitted)
SESSION_SECRET_KEY=replace-with-a-distinct-long-random-secret-key-for-session-cookies

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=30
OTP_EXPIRE_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# ==============================
# Rate Limiting & Request Limits
# ==============================
# Maximum request body size in bytes (default: 10MB)
MAX_REQUEST_BODY_SIZE_BYTES=10485760

# Authentication rate limiting (sliding-window: requests per minute and burst threshold)
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_BURST=20

# Comma-separated list of trusted reverse proxy IP addresses.
# Only requests originating from these proxies will have X-Forwarded-For parsed for client IP resolution.
TRUSTED_PROXIES=127.0.0.1,::1

# ==============================
# Google OAuth
# ==============================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ==============================
# Frontend & CORS
# ==============================
# In production (ENVIRONMENT=production), FRONTEND_URL must be an explicit, non-localhost URL (e.g. https://ytgenius.example.com).
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Comma-separated list of allowed Chrome Extension IDs (e.g. abcdefghijklmnop)
# Wildcards are rejected in production for defense against malicious extensions.
CHROME_EXTENSION_IDS=

# ==============================
# Email / SMTP
# ==============================
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM=your-email@gmail.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=True
MAIL_SSL_TLS=False

# ==============================
# Groq LLM
# ==============================
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b

# ==============================
# Qdrant Vector DB
# ==============================
# For production, set to your remote Qdrant Cloud or container URL (e.g. http://qdrant:6333 or https://xyz.qdrant.io:6333)
# In production, in-memory ":memory:" is strictly disallowed.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=youtube_video_chunks
VECTOR_DIMENSION=384

# ==============================
# ML Embedding & RERANKER
# ==============================
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
